# =============================================================================
# Abdullah Imported Goods — environment variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
# On Vercel, add the same variables in: Project → Settings → Environment Variables
#
# Where to find the Supabase values:
#     Supabase Dashboard → your project → Project Settings → API Keys
#     (and Project Settings → Data API for the project URL)
# =============================================================================

# --- Required -----------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase *publishable* key (starts with sb_publishable_...).
# Safe to expose in the browser: it can only do what Row Level Security allows.
# Older projects call this the "anon public" key — that works too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Recommended in production -------------------------------------------------

# The public address of your website, WITHOUT a trailing slash.
# Used in WhatsApp product links, the sitemap, and social sharing previews.
# On Vercel, if you leave this empty, your *.vercel.app production URL is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: phone notifications for new orders / likes ----------------------

# Secret key for Web Push (server-only — never put NEXT_PUBLIC_ in front).
# Create one with:  npx web-push generate-vapid-keys   (use the "Private Key")
# Without it, orders and likes still appear in the admin panel's bell.
VAPID_PRIVATE_KEY=

# --- NOT needed ----------------------------------------------------------------
# This app does NOT use the Supabase secret / service_role key. All admin
# actions run as the signed-in admin and are checked by Row Level Security.
# Never add the secret key to a variable that starts with NEXT_PUBLIC_.
